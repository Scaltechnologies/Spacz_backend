<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator only: builds all five services with one command (./mvnw clean verify).
  Every service has spring-boot-starter-parent as its own parent and can be built on its own,
  which is what each Dockerfile does.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.spacz</groupId>
    <artifactId>spacz-platform</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>spacz-platform</name>
    <description>SPACZ study-hall management platform (5 microservices)</description>

    <modules>
        <module>spacz-auth-service</module>
        <module>spacz-user-service</module>
        <module>spacz-studyhall-service</module>
        <module>spacz-admin-service</module>
        <module>spacz-gateway-service</module>
    </modules>
</project>
