# Production settings. On the VPS this file lives at /opt/spacz/.env (never commit the real one).
# Generate every secret with:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# --- deployment ---
# Port the gateway listens on, on 127.0.0.1 only (the host nginx proxies to it). Must be free.
GATEWAY_HOST_PORT=18080
# GHCR namespace the CI pushes to (lower-case GitHub org/user).
IMAGE_REGISTRY=ghcr.io/scaltechnologies

# --- shared secrets ---
JWT_SECRET=
JWT_ISSUER=spacz-auth
INTERNAL_API_KEY=

# --- PostgreSQL (passwords are only applied on the very first start of the database volume) ---
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
USER_DB_PASSWORD=
STUDYHALL_DB_PASSWORD=
ADMIN_DB_PASSWORD=

# --- first administrator (created on first auth-service start; can be removed afterwards) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- phone OTP ---
OTP_SMS_PROVIDER=log
OTP_EXPOSE_CODE=false
OTP_DEFAULT_COUNTRY_CODE=+91

# --- frontend origins allowed by CORS (comma separated, exact https URLs) ---
CORS_ALLOWED_ORIGINS=https://spacz.example.com,https://admin.spacz.example.com

# --- business settings ---
STUDYHALL_APPROVAL_REQUIRED=true
BOOKING_AUTO_CONFIRM=false
BOOKING_HOLD_DURATION=15m
BUSINESS_TIME_ZONE=Asia/Kolkata

# --- container memory (defaults suit an 8 GB VPS; lower them carefully on 4 GB) ---
SERVICE_MEM_LIMIT=768m
GATEWAY_MEM_LIMIT=512m
POSTGRES_MEM_LIMIT=512m
