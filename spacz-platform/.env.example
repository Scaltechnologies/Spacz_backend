# Copy to .env and replace EVERY value. .env is git-ignored; never commit real secrets.
# Generate strong values with:  openssl rand -base64 48

# --- shared secrets (identical for all services) ---
# HS256 signing key for JWTs: at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxxxxxx
JWT_ISSUER=spacz-auth
# Key used by services to call each other's /internal/** endpoints: at least 16 characters.
INTERNAL_API_KEY=replace-with-a-long-random-internal-key

# --- PostgreSQL ---
POSTGRES_PASSWORD=replace-postgres-superuser-password
POSTGRES_HOST_PORT=5432
AUTH_DB_PASSWORD=replace-auth-db-password
USER_DB_PASSWORD=replace-user-db-password
STUDYHALL_DB_PASSWORD=replace-studyhall-db-password
ADMIN_DB_PASSWORD=replace-admin-db-password

# --- first administrator (created on auth-service start if the email does not exist) ---
# Password: at least 12 characters. You can remove both values after the first start.
BOOTSTRAP_ADMIN_EMAIL=admin@spacz.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# --- phone OTP login ---
# "log" writes codes to the auth-service log (development). Implement SmsSender for a real SMS gateway.
OTP_SMS_PROVIDER=log
# DEVELOPMENT ONLY: return the code in the /api/auth/otp/request response. Never true in production.
OTP_EXPOSE_CODE=false
OTP_DEFAULT_COUNTRY_CODE=+91

# --- frontend origins allowed by CORS at the gateway (comma separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- business settings ---
STUDYHALL_APPROVAL_REQUIRED=true
# true = bookings are CONFIRMED immediately (no payment step); false = 15-minute PENDING hold + /confirm
BOOKING_AUTO_CONFIRM=false
BOOKING_HOLD_DURATION=15m
BUSINESS_TIME_ZONE=Asia/Kolkata

# --- host ports (change if something else already uses them) ---
GATEWAY_HOST_PORT=8080
AUTH_HOST_PORT=8081
USER_HOST_PORT=8082
STUDYHALL_HOST_PORT=8083
ADMIN_HOST_PORT=8084
